# Copy to your deployment secret store; do not commit real secrets.
# Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Format: comma-separated KEY:ROLE pairs. Roles: viewer, analyst, admin.
SPENDLENS_API_KEYS=replace_with_long_random_key_1:viewer,replace_with_long_random_key_2:analyst
SPENDLENS_DB=/app/data/spendlens.db
